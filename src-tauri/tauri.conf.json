{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mihomo Multi",
  "version": "0.1.0",
  "identifier": "com.mihomo.multi",
  "build": {
    "beforeDevCommand": "pnpm dev:sidecar",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mihomo Multi-Port",
        "width": 1100,
        "height": 750,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mihomo"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
