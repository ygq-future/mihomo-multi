# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source and config files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.exe binary
*.dll binary
*.zip binary
*.tar.gz binary
